# TripSense environment variables.
# Copy to .env and fill in values. NEVER commit a real .env file.
# Every variable is optional: without them TripSense runs in Demo Mode.

# --- Optional AI model (server-side only, never sent to the browser) ---
# When set, the BFF uses Claude to extract travel intent from free text.
# When empty, deterministic rule-based intent extraction is used (Demo Mode).
ANTHROPIC_API_KEY=
# Model used for intent extraction.
LLM_MODEL=claude-opus-5-5
# Max time to wait for the model before falling back to rules (ms).
LLM_TIMEOUT_MS=8000

# --- BFF server ---
PORT=8080
# Comma-separated list of origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# Set to "true" to print structured analytics events to stdout.
LOG_EVENTS=true
